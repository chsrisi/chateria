{
  "name": "chateria",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/protocol",
    "packages/server",
    "packages/client"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w @chateria/server",
    "dev:client": "npm run dev -w @chateria/client",
    "build": "npm run build -w @chateria/server && npm run build -w @chateria/client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @chateria/server"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2"
  }
}
