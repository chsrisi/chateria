# Copy to .env only if you want to override the Docker defaults below.
# The desktop apps do NOT read this file -- the server app keeps its settings
# in its own config store (edit them in the app's Settings pane, or via the
# CHATERIA_* variables listed at the bottom).

# --- Postgres (docker compose) ---
POSTGRES_USER=chateria
POSTGRES_PASSWORD=chateria
POSTGRES_DB=chateria
POSTGRES_PORT=5432

# --- Server app: first-run defaults only ---
# After first launch these live in the app's config file; the env vars are read
# only when the stored config has no value yet.
CHATERIA_DATABASE_URL=postgres://chateria:chateria@127.0.0.1:5432/chateria
CHATERIA_API_PORT=3000
CHATERIA_MAX_MESSAGE_LENGTH=4000
CHATERIA_TOKEN_TTL=7d

# --- Client app: first-run default server address ---
CHATERIA_SERVER_URL=http://127.0.0.1:3000

# --- Integration test target ---
TEST_API_URL=http://127.0.0.1:3000/api
TEST_WS_URL=ws://127.0.0.1:3000/ws
