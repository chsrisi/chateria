# Copy to .env if you want to override anything.
# The API service loads this file directly. Compose supplies matching defaults
# for database and web settings, so no separate .env file is required.

# --- Postgres ---
POSTGRES_USER=chateria
POSTGRES_PASSWORD=chateria
POSTGRES_DB=chateria
# Host port the database is published on (container port is always 5432).
POSTGRES_PORT=5432

# --- API ---
# Connection string used by the API. Host `db` is the compose service name.
DATABASE_URL=postgres://chateria:chateria@db:5432/chateria
# Port the API listens on, and the host port it is published on.
API_PORT=3000
# REQUIRED. HS256 signing secret for JWTs. No fallback exists in code:
# the API refuses to boot if this is empty. Use a long random value in production.
JWT_SECRET=dev-only-insecure-secret-change-me
# Token lifetime (any `jsonwebtoken` expiresIn value).
JWT_EXPIRES_IN=7d
# Maximum accepted message body length, in characters.
MAX_MESSAGE_LENGTH=4000

# --- Web ---
# Port the Vite dev server listens on, and the host port it is published on.
WEB_PORT=5173
# Optional. Leave both unset (the default) and the browser talks to whatever
# origin served the page, with the dev server proxying /api and /ws on to the
# API -- so the app works over localhost, a LAN address or a Tailscale
# hostname without a rebuild. Set them only to point the browser at an
# absolute API origin instead, e.g. an API on another host:
# VITE_API_URL=http://api.example.com:3000
# VITE_WS_URL=ws://api.example.com:3000/ws
